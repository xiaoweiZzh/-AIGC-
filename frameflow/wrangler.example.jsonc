{
  "name": "frameflow-studio",
  "main": "cloudflare.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/index", "/index.html", "/login", "/login.html", "/logout", "/api/*", "/reference/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "frameflow-studio",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "frameflow-studio" }]
}
